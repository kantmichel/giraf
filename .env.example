# GitHub OAuth App — create at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth.js — generate by running this command: openssl rand -base64 32
NEXTAUTH_SECRET=
# The public origin, used to build sign-in and OAuth callback URLs. Unset, they
# fall back to http://localhost:3000, so a deployed app redirects there.
NEXTAUTH_URL=http://localhost:3000
# Alternative to NEXTAUTH_URL behind a reverse proxy: take the origin from the
# proxy's X-Forwarded-Host/-Proto headers instead of pinning it. Set one or the
# other — AUTH_TRUST_HOST wins where both are set.
# AUTH_TRUST_HOST=true

# Database — optional, defaults to ./data/gira.db
DATABASE_PATH=
